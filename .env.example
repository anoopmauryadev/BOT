# ============================================================
#        EXAMPLE CONFIGURATION TEMPLATE (.env.example)
# Rename this file to .env and fill in your real credentials:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/Mac)
# ============================================================

# Telegram Bot Token & Admin Config
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_USER_ID=1234567890
ADMIN_USERNAME=admin
BOT_NAME=CRACK
DEVELOPER_LINK=https://t.me/your_developer_or_channel

# OSINT API Key & Endpoints
API_KEY=your_api_key_here
BASE_API_URL=http://127.0.0.1:8000/search
VEHICLE_INFO_API=https://anon-vehicle-info.vercel.app/veh2num?key=AnonyLomda@2009&rc={}
FAMILY_API_URL=https://anon-family-info.vercel.app/advanced/aadhar?key=AnonyLomda@2009&q={}

# Force Join Channel (Optional)
FORCE_JOIN_CHANNEL_ID=-1001234567890
FORCE_JOIN_CHANNEL_LINK=https://t.me/+your_invite_link
FORCE_JOIN_CHANNEL_NAME=CRACK Channel

# Payment Gateways
UPI_ID=your_upi@upi
USDT_WALLET=your_usdt_address
STORE_LINK=https://your-store-link.com
